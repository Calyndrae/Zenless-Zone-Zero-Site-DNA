ne-height: 2;\"\u003e\u003cimg src=\"https://fastcdn.hoyoverse.com/content-v2/nap/165998/8f865f6d4884a881cabfc6a718aaf196_279437206613817589.jpg\" href=\"\" data-origin-width=\"\" style=\"vertical-align:middle;\"\u003e\u003c/p\u003e","sExt":"{\"news-banner\":[{\"name\":\"CHS.jpg\",\"url\":\"https://fastcdn.hoyoverse.com/content-v2/nap/165998/4c65637cd1f6e8aa5c4e5720cbe4592f_3277214264560457878.jpg\"}],\"news-self-path\":\"\"}","dtStartTime":"2026-09-08 13:30:00","dtEndTime":"2035-01-01 00:00:00","dtCreateTime":"2026-09-07 10:01:43","iInfoId":165998,"sTagName":[],"sCategoryName":"","sSign":""}},"sSign":""}}
9bf421a_1983823742119813954.gif\" href=\"\" data-origin-width=\"\" style=\"vertical-align:middle;\"\u003e\u003c/p\u003e\u003cp style=\"white-space: pre-wrap; min-height: 1.5em; text-align: center; line-height: 2;\"\u003e\u003c/p\u003e\u003cp style=\"white-space: pre-wrap; min-height: 1.5em; text-align: center; line-height: 2;\"\u003e\u003cimg src=\"/archive/files/fastcdn.hoyoverse.com/content-v2/nap/165994/4336c8168aceb30fffa4fff36161e1bb_7455975987478733616.jpg\" href=\"\" data-origin-width=\"\" style=\"vertical-align:middle;\"\u003e\u003c/p\u003e","sExt":"{\"news-banner\":[{\"name\":\"CHS-1920.jpg\",\"url\":\"/archive/files/fastcdn.hoyoverse.com/content-v2/nap/165994/31524e72b7aad5ba4b64e39748d6dc75_3883785963502107251.jpg\"}]}","dtStartTime":"2026-09-08 19:00:00","dtEndTime":"2035-01-01 00:00:00","dtCreateTime":"2026-09-07 09:57:45","iInfoId":165994,"sTagName":[],"sCategoryName":"","sSign":""}},"sSign":""}}